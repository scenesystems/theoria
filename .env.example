# Theoria app runtime configuration
# Copy to .env and fill in values for local or production-like runs.

# App server
PORT=3876
BUILD_SHA=dev-local

# Demo execution policy
THEORIA_LOCAL_CONCURRENCY=8
THEORIA_PROVIDER_CONCURRENCY=2
THEORIA_LOCAL_TIMEOUT_MS=5000
THEORIA_PROVIDER_TIMEOUT_MS=120000
THEORIA_LOCAL_REQUESTS_PER_MINUTE=30
THEORIA_PROVIDER_REQUESTS_PER_MINUTE=4
THEORIA_RATE_LIMIT_WINDOW_MS=60000

# Provider selection (openai | anthropic | openrouter)
DSP_PROVIDER=openai
DSP_PROVIDER_MODEL=gpt-4o-mini

# Provider API keys (set the one matching your DSP_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional provider-specific overrides. Leave blank to use the defaults above.
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
# OPENROUTER_MODEL=
# OPENAI_API_URL=
# ANTHROPIC_API_URL=
# OPENROUTER_API_URL=
# ANTHROPIC_VERSION=
# OPENROUTER_REFERRER=https://theoria.scenesystems.io
# OPENROUTER_TITLE=Theoria

# Generic provider fallbacks are also accepted, but provider-specific values
# above take precedence. Prefer one key path per deployment to avoid ambiguity.
# DSP_PROVIDER_API_KEY=
# DSP_PROVIDER_API_URL=
