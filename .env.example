# Theoria app runtime configuration for local runs (`bun run app:theoria`).
# Copy to .env; deployments set these through `wrangler.jsonc` and the
# deployment workflow instead (see apps/theoria/DEPLOYMENT.md).

PORT=3876
BUILD_SHA=dev-local
# preview | production. Unset means preview. Only production is indexable.
RELEASE_STAGE=preview
