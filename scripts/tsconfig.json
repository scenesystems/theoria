{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@types/node", "bun-types"],
    "tsBuildInfoFile": "../.tsbuildinfo/crypto-release-scripts.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "paths": {
      "@scenesystems/digest": ["../packages/digest/src/index.ts"],
      "@scenesystems/sign": ["../packages/sign/src/index.ts"]
    }
  },
  "include": ["crypto-release-check.ts", "crypto-release/**/*.ts", "../packages/digest/scripts/fixture-schemas.ts"],
  "references": [{ "path": "../packages/digest/tsconfig.src.json" }, { "path": "../packages/sign/tsconfig.src.json" }]
}
