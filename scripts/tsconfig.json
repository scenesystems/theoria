  "compilerOptions": {
    "noEmit": true,
    "types": ["@types/node", "bun-types"],
    "tsBuildInfoFile": "../.tsbuildinfo/scripts.tsbuildinfo",
    "allowImportingTsExtensions": true
  },
  "include": [
    "api-reference.ts",
    "api-reference-review.ts",
