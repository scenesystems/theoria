{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@types/node", "bun-types"],
    "tsBuildInfoFile": "../.tsbuildinfo/scripts.tsbuildinfo",
    "allowImportingTsExtensions": true
  },
  "include": [
    "api-reference.ts",
    "api-reference-program.ts",
    "api-reference-convert.ts",
    "api-reference/**/*.ts",
    "check-readme-examples.ts",
    "readme-examples/**/*.ts",
    "typecheck/**/*.ts",
    "ensure-docs-assets.ts",
    "resolve-workspace-deps.ts",
    "release.ts",
    "release/**/*.ts",
    "../packages/digest/scripts/fixtures.ts"
  ],
  "references": [
    { "path": "../packages/docs-model/tsconfig.src.json" },
    { "path": "../packages/digest/tsconfig.src.json" }
  ]
}
