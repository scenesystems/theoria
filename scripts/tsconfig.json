{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@types/node", "bun-types"],
    "tsBuildInfoFile": "../.tsbuildinfo/crypto-release-scripts.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "paths": {
      "@scenesystems/digest": ["../packages/digest/src/index.ts"],
      "@scenesystems/sign": ["../packages/sign/src/index.ts"]
    }
  },
  "include": [
    "api-reference.ts",
    "api-reference-program.ts",
    "api-reference/**/*.ts",
    "compress-static-assets.ts",
    "crypto-release-check.ts",
    "crypto-release/**/*.ts",
    "ensure-docs-assets.ts",
    "../packages/digest/scripts/fixture-schemas.ts"
  ],
  "references": [
    { "path": "../packages/digest/tsconfig.src.json" },
    { "path": "../packages/docs-model/tsconfig.src.json" },
    { "path": "../packages/sign/tsconfig.src.json" },
    { "path": "../packages/source-proof/tsconfig.src.json" }
  ]
}
