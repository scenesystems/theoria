{
  "name": "@scenesystems/effect-math",
  "version": "0.4.0",
  "type": "module",
  "description": "Foundational numerics, linear algebra, statistics, and optimization for Effect",
  "license": "MIT",
  "homepage": "https://github.com/scenesystems/theoria/tree/main/packages/effect-math",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenesystems/theoria.git",
    "directory": "packages/effect-math"
  },
  "bugs": {
    "url": "https://github.com/scenesystems/theoria/issues"
  },
  "keywords": [
    "effect",
    "numerics",
    "linear-algebra",
    "statistics",
    "probability",
    "optimization",
    "mathematics",
    "scientific-computing"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": "dist"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Numeric": "./src/Numeric.ts",
    "./Algebra": "./src/Algebra.ts",
    "./LinearAlgebra": "./src/LinearAlgebra.ts",
    "./Calculus": "./src/Calculus.ts",
    "./Special": "./src/Special.ts",
    "./Probability": "./src/Probability.ts",
    "./Statistics": "./src/Statistics.ts",
    "./Optimization": "./src/Optimization.ts",
    "./Geometry": "./src/Geometry.ts",
    "./Complex": "./src/Complex.ts",
    "./Distribution": "./src/Distribution.ts",
    "./Policy": "./src/Policy.ts",
    "./Scalar": "./src/Scalar.ts",
    "./Backend": "./src/Backend.ts",
    "./Precision": "./src/Precision.ts",
    "./Autodiff": "./src/Autodiff.ts",
    "./Uncertainty": "./src/Uncertainty.ts",
    "./Computation": "./src/Computation.ts"
  },
  "scripts": {
    "check": "tsc -b tsconfig.src.json",
    "check:tests": "tsc -b tsconfig.test.json",
    "check:examples": "tsc -b tsconfig.examples.json",
    "lint": "cd ../.. && oxlint packages/effect-math && eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0 packages/effect-math && dprint check \"packages/effect-math/**\"",
    "lint:fix": "cd ../.. && oxlint --fix packages/effect-math && eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0 --fix packages/effect-math && dprint fmt \"packages/effect-math/**\"",
    "test": "vitest run --root ../.. packages/effect-math/test",
    "fixtures:check": "bun run scripts/check-fixtures.ts",
    "fixtures:generate": "bun run scripts/generate-scipy-fixtures.ts",
    "fixtures:lock": "uv lock --script scripts/generate-scipy-fixtures.py",
    "build-esm": "tsc -b tsconfig.build.json",
    "build-annotate": "babel build/esm --plugins annotate-pure-calls --out-dir build/esm --source-maps",
    "build-cjs": "babel build/esm --plugins @babel/transform-export-namespace-from --plugins @babel/transform-modules-commonjs --out-dir build/cjs --source-maps",
    "build": "bun run build-esm && bun run build-annotate && bun run build-cjs && build-utils pack-v3",
    "clean": "rm -rf build dist .tsbuildinfo"
  },
  "peerDependencies": {
    "effect": "^3.22.1"
  }
}
