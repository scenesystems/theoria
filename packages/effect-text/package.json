{
  "name": "@scenesystems/effect-text",
  "version": "0.4.2",
  "type": "module",
  "description": "Effect-native text preparation, measurement, and greedy multiline layout",
  "license": "MIT",
  "homepage": "https://github.com/scenesystems/theoria/tree/main/packages/effect-text",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenesystems/theoria.git",
    "directory": "packages/effect-text"
  },
  "bugs": {
    "url": "https://github.com/scenesystems/theoria/issues"
  },
  "keywords": [
    "effect",
    "text-layout",
    "text-measurement",
    "line-breaking",
    "typography",
    "canvas",
    "layout"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": "dist"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Text": "./src/Text.ts",
    "./TextMeasurer": "./src/TextMeasurer.ts",
    "./MeasurementCache": "./src/MeasurementCache.ts",
    "./Hyphenation": "./src/Hyphenation.ts",
    "./CanvasTextMeasurer": "./src/CanvasTextMeasurer.ts",
    "./CanvasProfile": "./src/CanvasProfile.ts",
    "./PreparationKey": "./src/PreparationKey.ts",
    "./Calibration": "./src/Calibration.ts"
  },
  "scripts": {
    "check": "tsc -b tsconfig.src.json",
    "check:tests": "tsc -b tsconfig.test.json",
    "check:examples": "tsc -b tsconfig.examples.json",
    "lint": "cd ../.. && oxlint packages/effect-text && eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0 packages/effect-text && dprint check \"packages/effect-text/**\"",
    "lint:fix": "cd ../.. && oxlint --fix packages/effect-text && eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0 --fix packages/effect-text && dprint fmt \"packages/effect-text/**\"",
    "test": "vitest run --root ../.. packages/effect-text/test",
    "bench": "bun benchmarks/run.ts",
    "build-esm": "tsc -b tsconfig.build.json",
    "build-annotate": "babel build/esm --plugins annotate-pure-calls --out-dir build/esm --source-maps",
    "build-cjs": "babel build/esm --plugins @babel/transform-export-namespace-from --plugins @babel/transform-modules-commonjs --out-dir build/cjs --source-maps --copy-files",
    "build": "bun run build-esm && bun run build-annotate && bun run build-cjs && build-utils pack-v3",
    "clean": "rm -rf build dist .tsbuildinfo"
  },
  "peerDependencies": {
    "effect": "^3.22.1"
  },
  "dependencies": {
    "@scenesystems/effect-math": "workspace:^",
    "@scenesystems/effect-search": "workspace:^",
    "@scenesystems/effect-study": "workspace:^"
  },
  "devDependencies": {
    "@scenesystems/digest": "workspace:^"
  }
}
