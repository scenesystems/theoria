{
  "name": "@scenesystems/effect-inference",
  "version": "0.3.0",
  "type": "module",
  "description": "Effect-native provider-blind inference runtime descriptors and resolution",
  "license": "MIT",
  "homepage": "https://github.com/scenesystems/theoria/tree/main/packages/effect-inference",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenesystems/theoria.git",
    "directory": "packages/effect-inference"
  },
  "bugs": {
    "url": "https://github.com/scenesystems/theoria/issues"
  },
  "keywords": [
    "effect",
    "inference",
    "llm",
    "embeddings",
    "huggingface",
    "openai-compatible",
    "runtime-resolution"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": "dist"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./Model": "./src/Model.ts",
    "./Route": "./src/Route.ts",
    "./Capabilities": "./src/Capabilities.ts",
    "./RuntimeRequest": "./src/RuntimeRequest.ts",
    "./Runtime": "./src/Runtime.ts",
    "./RuntimeEvidence": "./src/RuntimeEvidence.ts",
    "./TextProvider": "./src/TextProvider.ts",
    "./OpenAiCompatible": "./src/OpenAiCompatible.ts",
    "./HuggingFace": "./src/HuggingFace.ts",
    "./HuggingFaceEmbeddingModel": "./src/HuggingFaceEmbeddingModel.ts",
    "./HuggingFaceEndpoint": "./src/HuggingFaceEndpoint.ts",
    "./HuggingFaceRouted": "./src/HuggingFaceRouted.ts",
    "./InferenceError": "./src/InferenceError.ts",
    "./Usage": "./src/Usage.ts",
    "./AnthropicUsage": "./src/AnthropicUsage.ts",
    "./GoogleUsage": "./src/GoogleUsage.ts",
    "./OpenAiUsage": "./src/OpenAiUsage.ts",
    "./OpenRouterUsage": "./src/OpenRouterUsage.ts",
    "./Testing": "./src/Testing.ts",
    "./internal/*": null
  },
  "scripts": {
    "check": "tsc -b tsconfig.src.json",
    "check:tests": "tsc -b tsconfig.test.json",
    "check:examples": "tsc -b tsconfig.examples.json",
    "lint": "cd ../.. && oxlint packages/effect-inference && eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0 packages/effect-inference && dprint check \"packages/effect-inference/**\"",
    "lint:fix": "cd ../.. && oxlint --fix packages/effect-inference && eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0 --fix packages/effect-inference && dprint fmt \"packages/effect-inference/**\"",
    "test": "vitest run --root ../.. packages/effect-inference/test",
    "examples:verify": "bun --env-file=../../.env run scripts/verify-live-examples.ts",
    "build-esm": "tsc -b tsconfig.build.json",
    "build-annotate": "babel build/esm --plugins annotate-pure-calls --out-dir build/esm --source-maps",
    "build-cjs": "babel build/esm --plugins @babel/transform-export-namespace-from --plugins @babel/transform-modules-commonjs --out-dir build/cjs --source-maps",
    "build": "bun run build-esm && bun run build-annotate && bun run build-cjs && build-utils pack-v3",
    "clean": "rm -rf build dist .tsbuildinfo"
  },
  "peerDependencies": {
    "@effect/ai": ">=0.37.0",
    "effect": "^3.22.1"
  },
  "dependencies": {
    "@effect/ai-anthropic": "0.27.0",
    "@effect/ai-google": "0.16.0",
    "@effect/ai-openai": "0.41.0",
    "@effect/ai-openrouter": "0.12.0",
    "@effect/platform": "0.97.1",
    "@huggingface/inference": "^4.13.28"
  }
}
