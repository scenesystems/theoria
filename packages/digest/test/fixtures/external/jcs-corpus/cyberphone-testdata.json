    {
      "id": "cyberphone-jcs-corpus:structures",
      "input": {
        "1": {
          "f": {
            "f": "hi",
            "F": 5
          },
          "\n": 56
        },
        "10": {},
        "111": [
          {
            "e": "yes",
            "E": "no"
          }
        ],
        "": "empty",
        "a": {},
        "A": {}
      },
      "expectedCanonical": "{\"\":\"empty\",\"1\":{\"\\n\":56,\"f\":{\"F\":5,\"f\":\"hi\"}},\"10\":{},\"111\":[{\"E\":\"no\",\"e\":\"yes\"}],\"A\":{},\"a\":{}}"
    },
    {
      "id": "cyberphone-jcs-corpus:unicode",
      "input": {
        "Unnormalized Unicode": "Å"
      },
      "expectedCanonical": "{\"Unnormalized Unicode\":\"Å\"}"
    },
    {
