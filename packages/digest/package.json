{
  "name": "@scenesystems/digest",
  "version": "0.5.1",
  "type": "module",
  "description": "Cryptographic content hashing and canonicalization for Effect",
  "license": "MIT",
  "homepage": "https://github.com/scenesystems/theoria/tree/main/packages/digest",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenesystems/theoria.git",
    "directory": "packages/digest"
  },
  "bugs": {
    "url": "https://github.com/scenesystems/theoria/issues"
  },
  "keywords": [
    "effect",
    "blake3",
    "sha256",
    "digest",
    "content-addressing",
    "canonicalization",
    "jcs",
    "rfc8785",
    "fingerprint",
    "hashing"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": "dist"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc -b tsconfig.src.json",
    "check:tests": "tsc -b tsconfig.test.json",
    "check:examples": "tsc -b tsconfig.examples.json",
    "lint": "eslint --max-warnings=0 src test",
    "lint:fix": "eslint --max-warnings=0 --fix src test",
    "test": "vitest run --root ../.. packages/digest/test",
    "release-snapshots:stamp": "bun run stamp-release-snapshot.ts",
    "fixtures:check": "bun run scripts/check-fixtures.ts",
    "fixtures:stamp": "bun run scripts/stamp-fixture-hashes.ts",
    "fixtures:verify": "bun run fixtures:check && bun run test -- test/conformance",
    "benchmark:canonicalization:bun": "bun run benchmark/CanonicalizationResponsiveness.ts",
    "benchmark:canonicalization:node": "node --import tsx benchmark/CanonicalizationResponsiveness.ts",
    "publish:check": "bun run scripts/verify-publish-readiness.ts",
    "build-esm": "tsc -b tsconfig.build.json",
    "build-annotate": "babel build/esm --plugins annotate-pure-calls --out-dir build/esm --source-maps",
    "build-cjs": "babel build/esm --plugins @babel/transform-export-namespace-from --plugins @babel/transform-modules-commonjs --out-dir build/cjs --source-maps",
    "build": "bun run build-esm && bun run build-annotate && bun run build-cjs && build-utils pack-v3",
    "clean": "rm -rf build dist .tsbuildinfo",
    "changeset-publish": "bun run build && bun run publish:check --require-packed-manifest && bun run test && changeset publish"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "@theoria/source-proof": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^3.22.1"
  }
}
