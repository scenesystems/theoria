{
  "name": "@scenesystems/effect-dsp",
  "version": "0.4.0",
  "type": "module",
  "description": "Effect-native DSPy — programming, not prompting, language models",
  "license": "MIT",
  "homepage": "https://github.com/scenesystems/theoria/tree/main/packages/effect-dsp",
  "repository": {
    "type": "git",
    "url": "https://github.com/scenesystems/theoria.git",
    "directory": "packages/effect-dsp"
  },
  "bugs": {
    "url": "https://github.com/scenesystems/theoria/issues"
  },
  "keywords": [
    "effect",
    "dspy",
    "prompt-optimization",
    "llm",
    "declarative-signal-programming",
    "bayesian-optimization",
    "few-shot-learning"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": "dist"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Signature": "./src/Signature.ts",
    "./Module": "./src/Module.ts",
    "./ModuleParameters": "./src/ModuleParameters.ts",
    "./ModuleGraph": "./src/ModuleGraph.ts",
    "./Demonstration": "./src/Demonstration.ts",
    "./Example": "./src/Example.ts",
    "./Metric": "./src/Metric.ts",
    "./Evaluate": "./src/Evaluate.ts",
    "./EvaluationObjective": "./src/EvaluationObjective.ts",
    "./Artifact": "./src/Artifact.ts",
    "./Trace": "./src/Trace.ts",
    "./Cache": "./src/Cache.ts",
    "./Payload": "./src/Payload.ts",
    "./DspError": "./src/DspError.ts",
    "./OptimizerEvent": "./src/OptimizerEvent.ts",
    "./LabeledFewShot": "./src/LabeledFewShot.ts",
    "./BootstrapFewShot": "./src/BootstrapFewShot.ts",
    "./BootstrapRS": "./src/BootstrapRS.ts",
    "./MIPROv2": "./src/MIPROv2.ts",
    "./MIPROv2Candidates": "./src/MIPROv2Candidates.ts",
    "./MIPROv2Search": "./src/MIPROv2Search.ts",
    "./GEPA": "./src/GEPA.ts",
    "./Ensemble": "./src/Ensemble.ts",
    "./MockLanguageModel": "./src/MockLanguageModel.ts",
    "./internal/*": null
  },
  "scripts": {
    "check": "tsc -b tsconfig.src.json",
    "check:tests": "tsc -b tsconfig.test.json",
    "check:examples": "tsc -b tsconfig.examples.json",
    "lint": "cd ../.. && oxlint packages/effect-dsp && eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0 packages/effect-dsp && dprint check \"packages/effect-dsp/**\"",
    "lint:fix": "cd ../.. && oxlint --fix packages/effect-dsp && eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0 --fix packages/effect-dsp && dprint fmt \"packages/effect-dsp/**\"",
    "test": "vitest run --root ../.. packages/effect-dsp/test",
    "build-esm": "tsc -b tsconfig.build.json",
    "build-annotate": "babel build/esm --plugins annotate-pure-calls --out-dir build/esm --source-maps",
    "build-cjs": "babel build/esm --plugins @babel/transform-export-namespace-from --plugins @babel/transform-modules-commonjs --out-dir build/cjs --source-maps",
    "build": "bun run build-esm && bun run build-annotate && bun run build-cjs && build-utils pack-v3",
    "clean": "rm -rf build dist .tsbuildinfo"
  },
  "dependencies": {
    "@scenesystems/digest": "workspace:^",
    "@scenesystems/effect-math": "workspace:^",
    "@scenesystems/effect-search": "workspace:^",
    "@scenesystems/effect-study": "workspace:^"
  },
  "devDependencies": {
    "@scenesystems/effect-inference": "workspace:^"
  },
  "peerDependencies": {
    "@effect/ai": ">=0.37.0",
    "effect": "^3.22.1"
  }
}
