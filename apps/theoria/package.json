{
  "name": "@theoria/theoria-app",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:assets": "bun ../../scripts/api-reference.ts",
    "dev": "bun ../../scripts/ensure-docs-assets.ts && bun run server.ts",
    "dev:web": "bun ../../scripts/ensure-docs-assets.ts && vite --host 127.0.0.1 --port 5175 --strictPort",
    "check": "tsc -b tsconfig.src.json",
    "check:tests": "tsc -b tsconfig.test.json",
    "check:all": "bun run check && bun run check:tests",
    "lint": "eslint --max-warnings=0 \"server.ts\" \"worker.ts\" \"scripts/**/*.ts\" \"app/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"vite.config.ts\" \"vitest.config.ts\" \"vitest.worker.config.ts\"",
    "lint:fix": "eslint --max-warnings=0 --fix \"server.ts\" \"worker.ts\" \"scripts/**/*.ts\" \"app/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"vite.config.ts\" \"vitest.config.ts\" \"vitest.worker.config.ts\"",
    "test": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "build:web": "bun run docs:assets && vite build",
    "build": "bun run check:all && bun run build:web",
    "preview:worker": "bun run build:web && wrangler dev --env=\"\"",
    "deploy:dry-run": "wrangler deploy --env=\"\" --dry-run --outdir .wrangler-out",
    "gen:text-tokens": "bun scripts/generate-text-tokens.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@effect-atom/atom": "^0.5.3",
    "@effect-atom/atom-react": "^0.5.0",
    "@effect/ai": "0.37.0",
    "@effect/platform": "0.97.1",
    "@effect/platform-bun": "0.91.2",
    "@heroicons/react": "^2.2.0",
    "@scenesystems/digest": "workspace:^",
    "@scenesystems/effect-dsp": "workspace:^",
    "@scenesystems/effect-inference": "workspace:^",
    "@scenesystems/effect-math": "workspace:^",
    "@scenesystems/effect-search": "workspace:^",
    "@scenesystems/effect-text": "workspace:^",
    "@scenesystems/seal": "workspace:^",
    "@scenesystems/sign": "workspace:^",
    "@shikijs/core": "^3.23.0",
    "@shikijs/engine-oniguruma": "^3.23.0",
    "@shikijs/langs": "^3.23.0",
    "@shikijs/types": "^3.23.0",
    "@theoria/docs-model": "workspace:*",
    "effect": "3.22.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.0",
    "@theoria/source-proof": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "happy-dom": "^20.7.0",
    "tailwindcss": "^4.2.0",
    "vite": "^7.3.6",
    "wrangler": "4.128.0"
  }
}
