{
  "name": "@theoria/theoria-app",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:assets": "bun ../../scripts/api-reference.ts",
    "dev": "bun ../../scripts/ensure-docs-assets.ts && bun run server.ts",
    "dev:web": "bun ../../scripts/ensure-docs-assets.ts && vite --host 127.0.0.1 --port 5175 --strictPort",
    "check": "tsc -b tsconfig.src.json",
    "check:tests": "tsc -b tsconfig.test.json",
    "check:all": "bun run check && bun run check:tests",
    "lint": "cd ../.. && oxlint apps/theoria && eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0 apps/theoria && dprint check \"apps/theoria/**\"",
    "lint:fix": "cd ../.. && oxlint --fix apps/theoria && eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0 --fix apps/theoria && dprint fmt \"apps/theoria/**\"",
    "test": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "build:web": "bun run docs:assets && vite build",
    "build": "bun run check:all && bun run build:web",
    "build:check": "bun scripts/check-build-output.ts",
    "preview:worker": "bun run build:web && wrangler dev --env=\"\"",
    "deploy:dry-run": "wrangler deploy --env=\"\" --dry-run --outdir .wrangler-out",
    "gen:text-tokens": "bun scripts/generate-text-tokens.ts",
    "gen:social-assets": "bun scripts/generate-social-assets.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@effect-atom/atom": "^0.7.0",
    "@effect-atom/atom-react": "^0.7.0",
    "@effect/ai": "0.37.0",
    "@effect/platform": "0.97.1",
    "@effect/platform-browser": "0.77.1",
    "@effect/platform-bun": "0.91.2",
    "@heroicons/react": "^2.2.0",
    "@scenesystems/digest": "workspace:^",
    "@scenesystems/effect-dsp": "workspace:^",
    "@scenesystems/effect-inference": "workspace:^",
    "@scenesystems/effect-math": "workspace:^",
    "@scenesystems/effect-search": "workspace:^",
    "@scenesystems/effect-text": "workspace:^",
    "@scenesystems/seal": "workspace:^",
    "@scenesystems/sign": "workspace:^",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-oniguruma": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/types": "^4.4.3",
    "@theoria/docs-model": "workspace:*",
    "effect": "3.22.1",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.13.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wrangler": "4.128.0"
  }
}
