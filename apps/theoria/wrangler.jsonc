// Cloudflare Workers configuration for the Theoria site.
//
// One Worker script (`worker.ts`) serves the API, the HTML shell with
// per-route metadata, and the built web bundle (`dist/`) as static assets.
//
// Deployment targets (see `DEPLOYMENT.md`):
//   production  wrangler deploy --env ""          theoria.scenesystems.io
//   staging     wrangler deploy --env staging     theoria.staging.scenesystems.io
//   preview     wrangler deploy --env preview --name theoria-pr-<N> --domain theoria-pr-<N>.staging.scenesystems.io
//
// `vars` and `ratelimits` are not inherited by named environments, so each
// target declares `RELEASE_STAGE` and `PLACE_BUILD_LIMITER` explicitly. `routes`
// are inherited, so non-production environments override them to avoid
// claiming the production hostname.
//
// `PLACE_BUILD_LIMITER` guards `POST /api/imagined-place/build`, the only
// CPU-bound request the site serves. The key is the client address, so the
// limit is "builds per address per minute, per Cloudflare location". Each
// target has its own `namespace_id` because bindings sharing one share their
// counters account-wide. The binding holds no data and is safe on public
// preview Workers.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "theoria",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    // The Imagined Place build runs its search inside the Worker and is
    // CPU-bound; the Paid plan default is 30 s.
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker owns HTML routing (metadata injection, docs 404s, stage gating),
    // so the assets layer must not rewrite or fall back on its own.
    "html_handling": "none",
    "not_found_handling": "none",
    // Paths the Worker must see even when a matching asset exists. Everything
    // else is served directly from the edge when an asset matches and falls
    // through to the Worker otherwise (docs pages, unknown paths).
    // `test/worker/site.test.ts` runs the built Worker in workerd and checks
    // that these paths reach the Worker while hashed assets stay on the edge.
    "run_worker_first": ["/", "/index.html", "/api/*", "/docs", "/docs/*", "/sitemap.xml"]
  },
  "vars": {
    "RELEASE_STAGE": "production",
    // Analytics identifiers are public (they ship in the HTML). The Worker emits
    // the tags only on the canonical hostname, and an empty value disables that
    // provider (see app/server/config/analytics.ts and DEPLOYMENT.md).
    "GA_MEASUREMENT_ID": "G-SMK8QFW04J",
    "CF_WEB_ANALYTICS_TOKEN": "de23599e871148f486778e8089909aa5"
  },
  "ratelimits": [
    {
      "name": "PLACE_BUILD_LIMITER",
      "namespace_id": "1001",
      // `period` must be 10 or 60. `app/server/platform/workers-rate-limit.ts`
      // reports the same window in `retry-after`.
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "theoria.scenesystems.io",
      "custom_domain": true
    }
  ],
  "env": {
    "staging": {
      "name": "theoria-staging",
      "vars": {
        // Staging mirrors the production surface so it is a faithful rehearsal.
        "RELEASE_STAGE": "production"
      },
      "ratelimits": [
        {
          "name": "PLACE_BUILD_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "routes": [
        {
          "pattern": "theoria.staging.scenesystems.io",
          "custom_domain": true
        }
      ]
    },
    "preview": {
      // Name and hostname are supplied per pull request at deploy time.
      "vars": {
        "RELEASE_STAGE": "preview"
      },
      // All preview Workers share these counters, keyed by client address.
      "ratelimits": [
        {
          "name": "PLACE_BUILD_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "routes": []
    }
  }
}
